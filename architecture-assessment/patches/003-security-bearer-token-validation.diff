# Patch 003: Defense-in-Depth Bearer Token Domain Sanitization
# Intent: Ensure HTTP Authorization headers are only attached to requests targeting https://api.github.com
# Risk: Low (Prevents token leakage across HTTP redirects).
# Verification: Run `pytest tests/`

--- a/tools/builder/github_api.py
+++ b/tools/builder/github_api.py
@@ -3,6 +3,7 @@ from __future__ import annotations
 import json
 import sys
 import urllib.request
+from urllib.parse import urlparse
 from typing import Optional


 def http_json(url: str, token: Optional[str] = None):
     """Fetches a JSON response from an HTTP URL, supporting optional Bearer auth token."""
     headers = {"User-Agent": "app-hub-builder"}
     if token:  # only for api.github.com, never for download redirects
+        parsed = urlparse(url)
+        if parsed.scheme != "https" or parsed.hostname != "api.github.com":
+            raise ValueError(f"Security Policy Violation: Bearer token cannot be sent to {url}")
         headers.update({"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"})
     with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as r:
         data = json.load(r)
     return data
